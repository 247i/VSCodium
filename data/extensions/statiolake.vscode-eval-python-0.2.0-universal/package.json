{
	"name": "vscode-eval-python",
	"displayName": "Python Eval",
	"description": "Execute Python code in selections and replace with results",
	"version": "0.2.0",
	"publisher": "statiolake",
	"author": "statiolake <statiolake@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/statiolake/vscode-eval-python.git"
	},
	"bugs": {
		"url": "https://github.com/statiolake/vscode-eval-python/issues"
	},
	"homepage": "https://github.com/statiolake/vscode-eval-python#readme",
	"keywords": [
		"python",
		"eval",
		"execute",
		"selection",
		"replace"
	],
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"extensionKind": [
		"ui"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "pythonEval.evaluateSelection",
				"title": "Evaluate Selected Python Expression",
				"category": "Python Eval"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Python Eval",
			"properties": {
				"pythonEval.pythonPath": {
					"type": "string",
					"default": "python",
					"description": "Path to Python executable",
					"scope": "machine"
				},
				"pythonEval.defaultImports": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"import math",
						"import os",
						"import sys",
						"import json",
						"import datetime",
						"from datetime import datetime, timedelta"
					],
					"description": "Default imports to include in every execution"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "vsce package",
		"publish": "npm run publish:vsce && npm run publish:ovsx",
		"publish:vsce": "vsce publish",
		"publish:ovsx": "ovsx publish"
	},
	"devDependencies": {
		"@types/node": "16.x",
		"@types/vscode": "^1.74.0",
		"@vscode/vsce": "^3.9.2",
		"ovsx": "^1.1.1",
		"typescript": "^4.9.4"
	},
	"__metadata": {
		"installedTimestamp": 1792027614170,
		"targetPlatform": "universal",
		"size": 12743
	}
}